# Core app runtime (required in Vercel)
TOURNAMENT_YEAR=2026
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.<project-id>.supabase.co:5432/postgres?sslmode=require

# Optional runtime tuning
LOG_LEVEL=INFO

# Login delegates to walktober's auth API — this app stores no passwords.
# Defaults assume both apps are containers on the same Docker network
# (walktober_family), reachable by service name. Override for local dev.
WALKTOBER_AUTH_URL=http://walktober:3000/api/auth/sign-in/username
WALKTOBER_AUTH_ORIGIN=https://walktober.whoswinningnow.online

# Optional: only used by setup.py Supabase REST mode
# Leave DATABASE_URL unset when using this mode locally.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Notes:
# - In Vercel UI, paste values with NO surrounding quotes.
# - DATABASE_URL must be postgresql://... (not https://...)
